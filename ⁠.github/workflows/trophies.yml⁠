name: Crop and Save Trophies

on:
  schedule:
    - cron: '0 0 * * *' 
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Generate Trophies
        run: |
          curl -s "https://github-profile-trophy.vercel.app/?username=vv1ck&theme=tokyonight&no-frame=true&no-bg=true&margin-w=10&margin-h=10" -o trophies.svg
      - name: Commit & Push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add trophies.svg
          git commit -m "Update trophies" || exit 0
          git push
